SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS_URL=
# Secret key: server only. Never place in public/.
SUPABASE_SECRET_KEY=
# UUIDs from Supabase Auth, separated by commas. Empty denies access.
OEM_OPERATOR_IDS=
# Configuração inicial local, somente enquanto não existir conta no projeto.
# Defina o email autorizado; o próprio operador cria sua senha em /operador.html.
OEM_SETUP_EMAIL=
APP_ORIGIN=http://localhost:3000
PORT=3000
# Set to true only after reviewing queue and authorizing real collection.
CRAWLER_ENABLED=false
# A1 local: caminho fora do repositório. A senha é informada somente na UI.
SISCOMEX_A1_PATH=
SISCOMEX_OPERATOR_ID=
SISCOMEX_COMPANY_ROOT=
# validation ou production. O padrão é validation.
SISCOMEX_ENVIRONMENT=validation
